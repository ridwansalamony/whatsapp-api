# ==========================================
# KONFIGURASI SERVER
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# KONFIGURASI POSTGRESQL
# ==========================================
# Opsi 1: Menggunakan connection string (Disarankan)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/whatsapp_api

# Opsi 2: Menggunakan parameter terpisah (aktifkan jika DATABASE_URL dikosongkan)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgrespassword
# PGDATABASE=whatsapp_api
# PGSSL=false

# ==========================================
# KONFIGURASI WHATSAPP
# ==========================================
SESSION_NAME=my_whatsapp_vps_session

# Jika deploy di VPS Linux tanpa Docker dan memakai apt install chromium-browser:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ==========================================
# KEAMANAN API (Sangat Direkomendasikan di VPS)
# ==========================================
# Masukkan token/rahasia untuk melindungi endpoint /api/send-message & /api/logs
# Klien harus menyertakan header 'x-api-key: <token>' atau 'Authorization: Bearer <token>'
API_KEY=ubah_dengan_rahasia_api_key_anda
